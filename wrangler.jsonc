// Configuración de Cloudflare Workers para Ropero SG.
// Plan gratuito: sin "arranque en frío", 100.000 peticiones al servidor por día y una base de datos
// D1 de hasta 500 MB (5 GB es el total de la cuenta). Las fotos subidas desde el panel se guardan ahí.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ropero-sg",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Las páginas (HTML, CSS, JS, fotos) salen de /public. Todo lo que empieza con /api/ lo atiende el servidor.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Base de datos D1 "ropero-sg" (creada en el panel de Cloudflare).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ropero-sg",
      "database_id": "a0e5fe58-d082-4beb-b8c1-9582c073bab2",
      "migrations_dir": "migrations"
    }
  ],

  // Cada 10 minutos se anulan los pagos Webpay abandonados (las prendas vuelven al catálogo)
  // y se le vuelve a preguntar a Transbank por los pagos que quedaron sin confirmar.
  "triggers": { "crons": ["*/10 * * * *"] },

  // Variables públicas (no secretas). Las claves van con:  npx wrangler secret put NOMBRE
  // SMTP_SEGURIDAD solo acepta "tls" (puerto 465). En tu computador, .dev.vars reemplaza estos valores.
  "vars": {
    "WEBPAY_AMBIENTE": "integracion",
    "WEBPAY_CODIGO_COMERCIO": "597055555532",
    "MINUTOS_EXPIRA_WEBPAY": "20",
    "URL_PUBLICA": "",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PUERTO": "465",
    "SMTP_SEGURIDAD": "tls",
    "SMTP_USUARIO": "",
    "SMTP_REMITENTE": "",
    "CORREO_AVISOS": ""
  },

  "observability": { "enabled": true }
}
