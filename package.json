{
  "name": "ropero-sg",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda online del Ropero SG (Saint George's College): catálogo, pedidos y pagos con Webpay Plus.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrar": "wrangler d1 migrations apply DB --local",
    "db:migrar:remoto": "wrangler d1 migrations apply DB --remote",
    "db:semilla": "wrangler d1 execute DB --local --file seed/prendas-iniciales.sql",
    "db:semilla:remoto": "wrangler d1 execute DB --remote --file seed/prendas-iniciales.sql",
    "test": "node --test --test-concurrency=1 test/api.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "worker-mailer": "^1.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.155.0"
  }
}
